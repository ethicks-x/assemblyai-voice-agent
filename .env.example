# FieldPilot Environment Configuration

# 1. AssemblyAI (Required for live voice)
# Get your API key with free hackathon credits from:
# https://www.assemblyai.com/dashboard/signup?utm_source=event&utm_medium=credit-grant&utm_campaign=lablab_virtual_hackathon
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# 2. LLM Provider (Optional - defaults to AssemblyAI managed LLM if omitted, or BYO-LLM)
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 3. Server Configuration
PORT=3001
HOST=localhost
NODE_ENV=development

# 4. Telephony (Twilio - optional for live phone dial-in)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_URL=
